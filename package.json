{
  "name": "sample-library",
  "productName": "Sampleteka",
  "version": "0.3.0",
  "description": "Библиотека сэмплов для звукорежиссёров: индексирует папку, сама раскладывает звуки по категориям (RU/EN), поиск, прослушивание, перетаскивание в DAW.",
  "main": "src/main/main.js",
  "author": "Nick",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node --test \"test/*.test.js\"",
    "demo-library": "node scripts/make-demo-library.js",
    "dist": "electron-builder --win nsis portable"
  },
  "dependencies": {
    "music-metadata": "12.3.2"
  },
  "devDependencies": {
    "electron": "44.10.0",
    "electron-builder": "26.0.12"
  },
  "build": {
    "appId": "com.soundteam.sampleteka",
    "productName": "Sampleteka",
    "directories": { "output": "dist" },
    "files": ["src/**/*", "package.json"],
    "win": {
      "target": ["nsis", "portable"],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "Sampleteka-Setup-${version}.exe"
    },
    "portable": {
      "artifactName": "Sampleteka-Portable-${version}.exe"
    }
  }
}
