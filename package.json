{
  "name": "sample-library",
  "productName": "Sampleteka",
  "version": "0.4.0",
  "description": "Библиотека сэмплов для звукорежиссёров: индексирует папку, сама раскладывает звуки по категориям (RU/EN), поиск, прослушивание, перетаскивание в DAW.",
  "main": "src/main/main.js",
  "author": "Nick",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node --test \"test/*.test.js\"",
    "demo-library": "node scripts/make-demo-library.js",
    "dist": "electron-builder --win nsis portable",
    "dist:mac": "electron-builder --mac dmg zip"
  },
  "dependencies": {
    "music-metadata": "12.3.2"
  },
  "devDependencies": {
    "electron": "44.10.0",
    "electron-builder": "26.0.12"
  },
  "build": {
    "appId": "com.soundteam.sampleteka",
    "productName": "Sampleteka",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "Sampleteka-Setup-${version}.exe"
    },
    "portable": {
      "artifactName": "Sampleteka-Portable-${version}.exe"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "universal"
          ]
        }
      ],
      "icon": "build/icon-mac.png",
      "category": "public.app-category.music",
      "identity": null,
      "hardenedRuntime": false,
      "darkModeSupport": true,
      "artifactName": "Sampleteka-${version}-mac.${ext}"
    },
    "dmg": {
      "title": "Сэмплотека ${version}",
      "artifactName": "Sampleteka-${version}-mac.${ext}"
    },
    "afterPack": "build/adhoc-sign.js"
  }
}
